+        return {"identifier": "1"} if value else {"identifier": ""}
+    if key == "current_selection":
+        return {"identifier": "$"} if value else {"identifier": ""}
+    if key in ("bookmark", "state"):
+        name = str(value or "").strip()
+        if not name:
