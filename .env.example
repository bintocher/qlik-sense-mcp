# Qlik Sense Server Configuration
# Required: Qlik Sense server URL
QLIK_SERVER_URL=https://your-qlik-server.company.com

# Required: User directory for authentication
QLIK_USER_DIRECTORY=COMPANY

# Required: User ID for authentication
QLIK_USER_ID=your-username

# JWT mode: set this to switch the server to JWT mode - every call is then
# authenticated as the analyst encoded in the token, and no certificate
# files are needed. QLIK_SERVER_URL must carry the virtual proxy prefix as
# URL path (https://host/jwt). See docs/AUTH_JWT.md.
# QLIK_JWT_TOKEN=eyJhbGciOiJSUzI1NiJ9....

# Form (login/password) mode: set this to switch the server to form mode -
# it logs into a "Form based" virtual proxy's login page instead of using a
# client certificate or a JWT. See docs/AUTH_FORM.md.
# QLIK_PASSWORD=your-password

# Optional overrides for a non-default login page (form mode only): where
# the login redirect chain starts, and the form field names for the cases
# where auto-detection picks the wrong input.
# QLIK_FORM_LOGIN_PATH=
# QLIK_FORM_USERNAME_FIELD=
# QLIK_FORM_PASSWORD_FIELD=

# Register the 14 reload-task tools. Defaults to true in certificate mode
# and false in JWT/form mode, because QRS task administration needs a
# repository-admin role in the QMC. Set it explicitly to override.
# QLIK_TASK_TOOLS=true

# Certificate Configuration (Required for production)
# Absolute path to client certificate file (.pem format)
QLIK_CLIENT_CERT_PATH=/absolute/path/to/certs/client.pem

# Absolute path to client private key file (.pem format)
QLIK_CLIENT_KEY_PATH=/absolute/path/to/certs/client_key.pem

# Absolute path to CA certificate file (.pem format)
# If not specified, SSL certificate verification will be disabled
QLIK_CA_CERT_PATH=/absolute/path/to/certs/root.pem

# Network Configuration
# Repository API port (default: 4242)
QLIK_REPOSITORY_PORT=4242

# Proxy API port for authentication (default: 4243)
QLIK_PROXY_PORT=4243

# Engine API port for WebSocket connections (default: 4747)
QLIK_ENGINE_PORT=4747

# Optional HTTP API port for metadata requests (no default)
# Only used for /api/v1/apps/{id}/data/metadata endpoint
# QLIK_HTTP_PORT=443

# SSL and Security
# Verify TLS certificates (true/false, default: false).
# Off by default because Qlik Sense Enterprise serves a self-signed
# certificate; turn it on when Qlik presents one your machine trusts.
# QLIK_VERIFY_SSL=true

# Timeouts
# WebSocket timeout in seconds (default: 180.0)
# Applied to both the WebSocket handshake and ALL Engine API calls
# (OpenDoc, hypercube creation, GetLayout, field statistics, etc).
# Increase this value if hypercube creation or opening large apps times out
# with "Connection timed out" / "WebSocket recv() timed out".
QLIK_WS_TIMEOUT=180.0

# The remaining timings are constants rather than settings, listed here
# only so their values are known: a cached Engine connection is trusted
# without a check for 30s after the last frame Engine answered, the
# liveness request that proves an older socket is bounded by 15s, and a
# fresh socket's greeting frames are awaited for 15s before falling back
# to the next endpoint.

# Logging
# Logging level (DEBUG, INFO, WARNING, ERROR, default: INFO)
LOG_LEVEL=INFO

# Also write the log to a file. Useful in stdio mode, where stdout carries
# the protocol and the client usually swallows stderr - every tool call and
# its arguments end up here.
# QLIK_LOG_FILE=/var/log/qlik-sense-mcp.log

# Log the body of each reply as well as the call, truncated to 4000
# characters (default: false). Replies carry data, so this stays off
# unless you are auditing what a model was actually shown.
# QLIK_LOG_REPLIES=true

# Transport
# Port the Streamable HTTP transport listens on (default: 8000). The bind
# address is always 127.0.0.1. Ignored in stdio mode (--stdio).
# MCP_PORT=8000
