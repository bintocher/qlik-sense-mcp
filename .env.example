# Startup route (same command in both modes): qlik-sense-mcp-server
# legacy: existing certificate / environment-JWT / form authentication.
# incoming-jwt: each HTTP request supplies its own Qlik JWT bearer token.
# See .env.incoming.example and docs/INCOMING_JWT.md for a minimal gateway setup.
QLIK_MCP_MODE=legacy

# Qlik Sense Server Configuration
# The three legacy authentication modes need different variables:
# certificate: URL, user directory/id and certificate paths
# JWT: URL with virtual proxy prefix and QLIK_JWT_TOKEN
# form: URL, user ID and QLIK_PASSWORD; directory is optional
# Incoming JWT mode: URL with prefix only; credentials arrive in HTTP headers.
QLIK_SERVER_URL=https://your-qlik-server.company.com
QLIK_USER_DIRECTORY=COMPANY
QLIK_USER_ID=your-username

# Legacy environment-JWT mode (not a gateway credential):
# QLIK_JWT_TOKEN=eyJhbGciOiJSUzI1NiJ9....
# Legacy form mode:
# QLIK_PASSWORD=your-password
# QLIK_FORM_LOGIN_PATH=
# QLIK_FORM_USERNAME_FIELD=
# QLIK_FORM_PASSWORD_FIELD=

# Legacy task-tool registration. Incoming JWT workers disable these tools.
# QLIK_TASK_TOOLS=true

# Certificate configuration (legacy certificate mode):
QLIK_CLIENT_CERT_PATH=/absolute/path/to/certs/client.pem
QLIK_CLIENT_KEY_PATH=/absolute/path/to/certs/client_key.pem
# The CA path does not switch verification on/off.
QLIK_CA_CERT_PATH=/absolute/path/to/certs/root.pem
QLIK_REPOSITORY_PORT=4242
QLIK_ENGINE_PORT=4747

# TLS behavior is unchanged in every mode; verification is optional.
# QLIK_VERIFY_SSL=true

QLIK_WS_TIMEOUT=180.0
QLIK_TOOL_TIMEOUT=240.0
# Legacy session behavior; incoming workers disable disk persistence/logout.
# QLIK_PROXY_LOGOUT=true
# QLIK_SESSION_CACHE=true

# Logging (legacy server):
LOG_LEVEL=INFO
# QLIK_LOG_FILE=/var/log/qlik-sense-mcp.log
# QLIK_LOG_REPLIES=true

# HTTP bind remains 127.0.0.1. Ignored by legacy --stdio.
# MCP_PORT=8000

# Incoming JWT gateway limits (only with QLIK_MCP_MODE=incoming-jwt):
# QLIK_INCOMING_MAX_CONTEXTS=128
# QLIK_INCOMING_IDLE_SECONDS=900
# QLIK_INCOMING_MAX_AGE_SECONDS=0
# QLIK_INCOMING_START_TIMEOUT=120
# QLIK_INCOMING_MAX_STARTS=4
# QLIK_INCOMING_STARTS_PER_MINUTE=30
# QLIK_INCOMING_MAX_BODY_BYTES=4194304
# QLIK_INCOMING_BODY_TIMEOUT=30
