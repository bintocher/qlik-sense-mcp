# Incoming Qlik JWT mode example. Copy to .env or set these variables in
# the service environment, then run: qlik-sense-mcp-server
QLIK_MCP_MODE=incoming-jwt
QLIK_SERVER_URL=https://qlik.example.com/jwt
MCP_PORT=8000
# Default on a bare host is loopback. Docker image sets 0.0.0.0 internally.
# MCP_HOST=127.0.0.1

# TLS verification remains optional, with existing defaults unchanged.
# QLIK_VERIFY_SSL=true
# QLIK_CA_CERT_PATH=/path/to/trusted/ca.pem

# Capacity and startup protection (new tokens never evict healthy workers).
QLIK_INCOMING_MAX_CONTEXTS=128
QLIK_INCOMING_IDLE_SECONDS=900
QLIK_INCOMING_MAX_AGE_SECONDS=0
QLIK_INCOMING_START_TIMEOUT=120
QLIK_INCOMING_MAX_STARTS=4
QLIK_INCOMING_STARTS_PER_MINUTE=30

# Bound request-body buffering and upload time.
QLIK_INCOMING_MAX_BODY_BYTES=4194304
QLIK_INCOMING_BODY_TIMEOUT=30

# Do not set a user token here. Each MCP request supplies its own
# Authorization: Bearer header. Same-token conversations share Qlik state.
# QLIK_JWT_TOKEN and QLIK_PASSWORD are not used as gateway credentials.
# For Docker, compose.yaml uses a conservative 16-worker default unless
# overridden by QLIK_INCOMING_MAX_CONTEXTS. See docs/DOCKER.md.
